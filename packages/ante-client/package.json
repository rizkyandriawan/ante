{
  "name": "ante-client",
  "version": "0.1.0",
  "description": "Typed TypeScript client for Ante over its AMQP 0-9-1 endpoint",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx test/smoke.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "amqplib": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
